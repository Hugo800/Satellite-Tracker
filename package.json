{
  "name": "orbital-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mobile-first PWA \u2013 interaktiver 3D-Sternenatlas mit Echtzeit-Satelliten-Tracking",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "verify:fastpath": "esbuild scripts/verify-fastpath.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-fastpath.mjs --log-level=warning && node node_modules/.cache/verify-fastpath.mjs",
    "verify:orientation": "esbuild scripts/verify-orientation.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-orientation.mjs --log-level=warning && node node_modules/.cache/verify-orientation.mjs",
    "verify:rig": "esbuild scripts/verify-rig.ts --bundle --platform=node --format=esm --jsx=automatic --alias:@react-three/fiber=./scripts/stubs/react-three-fiber.ts --alias:@react-three/drei=./scripts/stubs/react-three-drei.ts --outfile=node_modules/.cache/verify-rig.mjs --log-level=warning && node node_modules/.cache/verify-rig.mjs",
    "verify:wiring": "esbuild scripts/verify-wiring.ts --bundle --platform=node --format=esm --jsx=automatic --outfile=node_modules/.cache/verify-wiring.mjs --log-level=warning && node node_modules/.cache/verify-wiring.mjs",
    "verify:selection": "esbuild src/workers/sgp4.worker.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-selection-worker.mjs --log-level=warning && esbuild scripts/verify-selection.ts --bundle --platform=node --format=esm --jsx=automatic --outfile=node_modules/.cache/verify-selection.mjs --log-level=warning && node node_modules/.cache/verify-selection.mjs",
    "verify:viewport": "esbuild scripts/verify-viewport.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-viewport.mjs --log-level=warning && node node_modules/.cache/verify-viewport.mjs",
    "verify:passes": "esbuild scripts/verify-passes.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verify-passes.mjs --log-level=warning && node node_modules/.cache/verify-passes.mjs",
    "bench:propagation": "esbuild scripts/bench-propagation.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bench-propagation.mjs --log-level=warning && node node_modules/.cache/bench-propagation.mjs",
    "test": "npm run typecheck && npm run lint && npm run verify:fastpath && npm run verify:orientation && npm run verify:rig && npm run verify:wiring && npm run verify:selection && npm run verify:viewport && npm run verify:passes"
  },
  "dependencies": {
    "@react-three/drei": "^10.1.2",
    "@react-three/fiber": "^9.1.2",
    "astronomy-engine": "^2.1.19",
    "lucide-react": "^0.513.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "satellite.js": "^5.0.0",
    "three": "^0.177.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.8",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.177.0",
    "@vitejs/plugin-react": "^4.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}
